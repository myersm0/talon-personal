app: /photoshop/i
-

undo:
	key(cmd-z)

redo:
	key(cmd-shift-z)

zoom in:
	key(cmd-+)

zoom out:
	key(cmd--)

fit (on|to) screen:
	key(cmd-0)

([one] hundred percent)|actual size:
	key(cmd-1)

select all:
	key(cmd-a)

deselect:
	key(cmd-shift-a)

invert:
	key(cmd-i)

layer jump:
	key(cmd-j)

layer mash:
	key(cmd-alt-shift-e)

merge visible:
	key(cmd-shift-e)

black and white:
	key(cmd-alt-shift-b)





